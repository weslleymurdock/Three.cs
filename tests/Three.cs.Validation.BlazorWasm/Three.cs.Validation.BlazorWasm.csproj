<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!--
    Validation host for Issue #5. It consumes the Three.cs RCL only through its ProjectReference and the
    `_content/Three.cs/...` Static Web Assets: this project owns no copy of the Three.js runtime assets.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Three.Validation.BlazorWasm</RootNamespace>
    <IsPackable>false</IsPackable>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.14" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Three.cs\Three.cs.csproj" />
  </ItemGroup>

</Project>