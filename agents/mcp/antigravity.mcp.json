{
  "$schema": "https://json.schemastore.org/mcp.json",
  "mcpServers": {
    "github": {
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "scripts/Start-Mcp-GitHub.ps1"]
    },
    "filesystem": {
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "scripts/Start-Mcp-Filesystem.ps1"]
    },
    "playwright": {
      "url": "http://localhost:8931/mcp"
    }
  }
}
